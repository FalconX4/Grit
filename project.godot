; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Grit"
run/main_scene="res://Scenes/Game/Levels/Intro.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DataManager="*res://Scripts/Global/DataManager.gd"
Localization="*uid://g7xbjwq6fu38"
SettingManager="*uid://clgn86ewwx6s7"
InputManager="*uid://cc7pxnepq8nn0"
PlayerDataManager="*uid://syufnr86b1eu"
GameSessionData="*uid://dtjri0mepm0yx"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Grit"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/FontInputDataMapper/plugin.cfg", "res://addons/InputMapGeneratorScript/plugin.cfg", "res://addons/ItemParser/plugin.cfg", "res://addons/LocalizationMapGeneratorScript/plugin.cfg")

[gui]

theme/custom_font="uid://bn42pm2l0cmre"

[importer_defaults]

csv_translation={
&"delimiter": 1
}

